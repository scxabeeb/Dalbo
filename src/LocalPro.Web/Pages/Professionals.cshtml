@page
@model ProfessionalsModel
@{ViewData["Title"]="Find your local expert";}
<section class="hero"><div class="hero-content"><span class="eyebrow"><span class="pulse"></span> YOUR NEIGHBORHOOD. YOUR EXPERTS.</span><h1>A helping hand.<br/>Just around <em>the corner.</em></h1><p>From a dripping tap to a cooler home, find skilled local<br class="desktop"/> professionals who get the job done right.</p><div class="hero-proof"><span class="mini-avatars"><i>AM</i><i>FA</i><i>YH</i></span><span><strong>Local skills. Real connections.</strong><br/><small>Discover the people behind the great work.</small></span></div></div><div class="hero-art" aria-hidden="true"><div class="art-grid"></div><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="house"><svg viewBox="0 0 320 300"><path d="M48 135 160 38 272 135" fill="none" stroke="#16202e" stroke-width="22" stroke-linecap="round" stroke-linejoin="round"/><path d="M72 133v124h176V133L160 62z" fill="#fff5ee"/><rect x="133" y="172" width="55" height="85" rx="8" fill="#16202e"/><rect x="88" y="151" width="31" height="36" rx="5" fill="#ffbd94"/><rect x="204" y="151" width="26" height="36" rx="5" fill="#ffbd94"/><path d="M105 151v36m-17-18h31m98-18v36m-13-18h26" stroke="#fff5ee" stroke-width="3"/></svg></div><div class="floating tool-one">ϟ</div><div class="floating tool-two">❄</div><div class="floating tool-three">◉</div><div class="art-badge"><span class="badge-check">✓</span><div><strong>Your home, in good hands</strong><small>Skilled people from your community</small></div></div><span class="art-spark">✦</span></div></section>
<section class="search-area"><form method="get" class="search-bar"><label><span>WHAT DO YOU NEED?</span><input asp-for="Q" placeholder="Electrician, plumber, AC repair…"/></label><label class="location"><span>⌖ LOCATION</span><input asp-for="City" placeholder="City or neighborhood"/></label><button class="btn" type="submit">Find a professional <span>↗</span></button></form></section>
<section class="content"><div class="section-heading"><div><span class="eyebrow muted">A LITTLE HELP GOES A LONG WAY</span><h2>What can we help with?</h2></div><a class="text-link" href="#professionals">Explore professionals ↗</a></div><div class="categories"><a class="category @(Model.Category==null?"active":"")" asp-page="/Professionals"><span class="category-icon">⌘</span><strong>All services</strong><small>A solution for every home</small></a>@foreach(var c in Model.Categories){<a class="category @(Model.Category==c.Id?"active":"")" asp-page="/Professionals" asp-route-category="@c.Id" asp-route-city="@Model.City"><span class="category-icon">@c.Icon</span><strong>@c.Name</strong><small>Local specialists</small></a>}</div>
<div class="section-heading professionals-heading" id="professionals"><div><span class="eyebrow muted">THE RIGHT PEOPLE, RIGHT NEARBY</span><h2>Meet your local professionals<span class="count">@Model.Professionals.Count</span></h2><p>Find someone you’ll be happy to call again.</p></div><form method="get"><input type="hidden" name="Q" value="@Model.Q"/><input type="hidden" name="Category" value="@Model.Category"/><input type="hidden" name="City" value="@Model.City"/><label class="toggle-label"><input type="checkbox" name="Available" value="true" checked="@Model.Available" data-autosubmit/> Accepting requests</label></form></div>
<div class="professionals">@foreach(var p in Model.Professionals){<article class="pro-card"><div class="card-top"><div class="avatar avatar-@(p.Id%4)">@string.Concat(p.Name.Split(' ').Take(2).Select(n=>n[0]))</div><span class="availability @(p.AcceptingRequests?"":"unavailable")"><span>●</span> @(p.AcceptingRequests?"Accepting requests":"Currently unavailable")</span></div><span class="pro-category">@p.Category.Icon @p.Category.Name</span><h3><a asp-page="/Professional/Details" asp-route-id="@p.Id">@p.Name <span class="verified" title="Profile approved; qualifications not independently verified">✓</span></a></h3><p class="pro-location">⌖ @p.Neighborhood, @p.City</p><div class="rating"><span>★</span> @(p.Reviews.Count>0?p.Reviews.Average(r=>r.Rating).ToString("0.0"):"New") <small>(@p.Reviews.Count reviews)</small><span class="divider">·</span><small>@p.YearsExperience years experience</small></div><div class="card-bottom"><span><strong>$@p.HourlyRate.ToString("0")</strong><small> / hour, starting from</small></span><a class="btn outline small" asp-page="/Professional/Details" asp-route-id="@p.Id">View profile ↗</a></div></article>}</div>@if(Model.Professionals.Count==0){<div class="empty"><span>⌕</span><h3>No professionals found</h3><p>Try another service or neighborhood.</p><a class="btn" asp-page="/Professionals">Clear filters</a></div>}
<div class="how"><div><span class="eyebrow muted">LESS HASSLE. MORE DONE.</span><h2>A better way to get<br/>things taken care of.</h2></div><div><span class="step">01</span><h3>Find your expert</h3><p>Explore local professionals and choose the right fit.</p></div><div><span class="step">02</span><h3>Have a conversation</h3><p>Share what you need and agree on the details.</p></div><div><span class="step">03</span><h3>Make it happen</h3><p>Request a time that works for you. They’ll confirm it.</p></div></div><section class="join-banner"><div><span class="eyebrow">GOOD AT WHAT YOU DO?</span><h2>Your next customer is nearby.</h2><p>Put your skills on the map. Grow your business with DANXALIYE.</p></div><a class="btn cream" asp-page="/Professional/Edit">Join as a professional ↗</a></section></section>
