@page
@model ProfessionalsModel
@{ViewData["Title"]="Assigned professionals";}
<div class="page"><div class="dx-catalog-header"><span class="eyebrow">COORDINATED BY OUR DISPATCH TEAM</span><h1>Your assigned professionals.</h1><p>Submit your request first. Our team reviews it and assigns a suitable professional. Contact and chat become available after assignment.</p><a class="btn dx-white" asp-page="/Services">Submit a service request ↗</a></div><div class="product-grid">@foreach(var p in Model.Professionals){<article class="panel"><span class="eyebrow muted">@p.Category.Name</span><h2>@p.Name</h2><p>@p.City</p><a class="text-link" asp-page="/Professional/Details" asp-route-id="@p.Id">View assigned professional ↗</a></article>}</div>@if(Model.Professionals.Count==0){<section class="panel"><h2>Your professional will appear after assignment.</h2><p class="notice">The dispatch team handles matching. Track your request for assignment and progress updates.</p><a class="btn" asp-page="/Requests/Index">Track requests ↗</a></section>}</div>
