@page
@model DispatchModel
@{ViewData["Title"]="Maamulka dalabyada";}
<div class="page"><div class="page-heading"><h1>Maamulka dalabyada</h1><p>U xilsaar xirfadle adeeggiisa la jaanqaadaya dalabka.</p></div>@if(TempData["Error"] is string error){<div class="error">@error</div>}@if(Model.Items.Count==0){<section class="panel admin-empty">No service requests yet. New customer requests will appear here for assignment.</section>}@foreach(var r in Model.Items){<article class="panel dx-dispatch-card"><span class="status">#@r.Id · @ServiceCatalog.Status(r.Status)</span><h3>@r.Category.Name</h3><p>@r.Description</p><p class="notice">@r.City · @r.Address · @ServiceCatalog.When(r.When)</p><a class="text-link" asp-page="/Requests/Track" asp-route-id="@r.Id">La soco dalabka ↗</a><div class="actions">@if(r.Status==ServiceRequestStatus.Received||r.Status==ServiceRequestStatus.Assigned){<form method="post" class="actions"><input type="hidden" name="id" value="@r.Id"/><input type="hidden" name="action" value="assign"/><select name="professionalId" aria-label="Xirfadlaha" required><option value="">Dooro xirfadle</option>@foreach(var p in Model.Professionals.Where(p=>p.CategoryId==r.CategoryId&&p.UserId!=r.CustomerId)){<option value="@p.Id">@p.Name · @p.City</option>}</select><button class="btn small" type="submit">U xilsaar</button></form>}@if(r.Status==ServiceRequestStatus.Assigned||r.Status==ServiceRequestStatus.OnTheWay||r.Status==ServiceRequestStatus.InProgress){var action=r.Status==ServiceRequestStatus.Assigned?"depart":r.Status==ServiceRequestStatus.OnTheWay?"start":"complete";<form method="post"><input type="hidden" name="id" value="@r.Id"/><button class="btn small outline" name="action" value="@action">@(action=="depart"?"Jidka":action=="start"?"Bilow shaqada":"Dhammee")</button></form>}</div></article>}<details class="panel"><summary>Qiimaha booqashada adeegyada</summary><p class="notice">Qiime bannaan wuxuu ka dhigan yahay in qiimaha la soo xaqiijinayo. Dalab hore qiimihiisu isma beddelayo.</p>@foreach(var c in Model.Categories){<form method="post" asp-page-handler="Fee" class="dx-fee-row"><strong>@c.Name</strong><input type="hidden" name="category" value="@c.Id"/><input type="number" name="fee" value="@c.VisitFee" min="0" max="10000" step="0.01" aria-label="Qiimaha @c.Name"/><button class="btn small outline" type="submit">Kaydi</button></form>}</details></div>