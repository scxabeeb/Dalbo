@page
@model ServicesModel
@{ViewData["Title"]="Adeegyada";}
<div class="dx-home"><div class="dx-catalog-header"><a asp-page="/Index">← Hoyga</a><h1>Adeegyada</h1><p>Hal meel ka hel adeeg kasta</p><div class="dx-filter-row">@foreach(var group in new[]{"Dhammaan"}.Concat(Model.Groups)){<a class="dx-chip @((Model.Group??"Dhammaan")==group?"selected":"")" asp-route-group="@(group=="Dhammaan"?null:group)" asp-route-q="@Model.Q">@group</a>}</div></div><form method="get" class="dx-search"><input name="q" value="@Model.Q" aria-label="Raadi adeeg" placeholder="Raadi adeeg…"/><input type="hidden" name="group" value="@Model.Group"/><button class="btn" type="submit">Raadi</button></form><div class="dx-service-grid dx-catalog-grid">@foreach(var c in Model.Categories){<a class="dx-service" asp-page="/Requests/New" asp-route-category="@c.Id"><span class="dx-service-icon"><svg aria-hidden="true" width="25" height="25"><use href="/brand/services.svg#@ServiceCatalog.IconKey(c.Name)"/></svg></span><strong>@c.Name</strong><small>@c.Description</small><span class="dx-service-arrow">↗</span></a>}</div>@if(Model.Categories.Count==0){<div class="empty"><h3>Adeeg lama helin</h3><p>Raadi magac kale ama eeg adeegyada oo dhan.</p><a class="btn" asp-page="/Services">Dhammaan</a></div>}<p class="notice">Ma heli weyday? Ka eeg <a asp-page="/Professionals">xirfadlayaasha</a> ama dooro adeeg kale.</p></div>