@page
@model LocalPro.Web.Pages.Professional.EditModel
@{ViewData["Title"]="Your professional profile";}
<div class="page"><a class="text-link" asp-page="/Safety">Manage blocked accounts ↗</a><div class="page-heading"><span class="eyebrow muted">BUILD YOUR LOCAL BUSINESS</span><h1>Great work starts with you.</h1><p>Create a profile that helps the neighborhood get to know you.</p></div>@if(TempData["Success"] is string success){<div class="success">@success</div>}@if(Model.Approved.HasValue){<p class="status">@(Model.Approved.Value?"Profile published":"Awaiting administrator approval")</p>}<form method="post" class="panel"><div asp-validation-summary="All"></div><div class="form-row"><label class="field"><span>Name or business name</span><input asp-for="Input.Name" maxlength="100" required/></label><label class="field"><span>Your specialty</span><select asp-for="Input.CategoryId">@foreach(var c in Model.Categories){<option value="@c.Id">@c.Name</option>}</select></label></div><div class="form-row"><label class="field"><span>City</span><input asp-for="Input.City" maxlength="100" required/></label><label class="field"><span>Neighborhood</span><input asp-for="Input.Neighborhood" maxlength="100"/></label></div><label class="field"><span>About you and your services</span><textarea asp-for="Input.Bio" maxlength="2000"></textarea></label><label class="field"><span>Public business phone (optional)</span><input asp-for="Input.Phone" type="tel" maxlength="30"/><p class="field-hint">By entering a number, you agree to display it publicly on your profile.</p></label><div class="form-row"><label class="field"><span>Starting hourly rate (USD)</span><input asp-for="Input.HourlyRate" type="number" min="0" max="10000" step="0.01"/></label><label class="field"><span>Years of experience</span><input asp-for="Input.YearsExperience" type="number" min="0" max="70"/></label></div><div class="form-row"><label class="field"><span>Start hour (0–23, East Africa Time)</span><input asp-for="Input.StartHour" type="number" min="0" max="23"/></label><label class="field"><span>End hour (1–24, East Africa Time)</span><input asp-for="Input.EndHour" type="number" min="1" max="24"/></label></div><label class="toggle-label"><input asp-for="Input.AcceptingRequests"/> Accepting appointment requests</label><div class="actions"><button class="btn" type="submit">Submit for approval ↗</button></div></form></div>
