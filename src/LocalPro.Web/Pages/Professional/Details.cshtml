@page "{id:int}"
@model LocalPro.Web.Pages.Professional.DetailsModel
@{ViewData["Title"]=Model.Pro.Name;var p=Model.Pro;}
<div class="page"><div class="breadcrumbs"><a asp-page="/Index">Find a professional</a> / @p.Category.Name / @p.Name</div>@if(TempData["Error"] is string error){<div class="error">@error</div>}@if(TempData["Success"] is string success){<div class="success">@success</div>}<div class="detail-grid"><section class="panel"><div class="profile-head"><div class="avatar avatar-@(p.Id%4)">@string.Concat(p.Name.Split(' ').Take(2).Select(n=>n[0]))</div><div><span class="pro-category">@p.Category.Icon @p.Category.Name</span><h1>@p.Name <span class="verified">✓</span></h1><p class="pro-location">⌖ @p.Neighborhood, @p.City</p></div></div><div class="detail-section"><span class="availability">@(p.AcceptingRequests?"● Accepting requests":"Currently unavailable")</span><p class="notice">Profile approved by LocalPro. Qualifications have not been independently verified.</p><div class="tags"><span class="tag">@p.YearsExperience years of experience</span><span class="tag">@p.StartHour:00–@p.EndHour:00 · EAT</span><span class="tag">@p.Reviews.Count reviews</span></div></div><div class="detail-section"><h3>A little about me</h3><p>@p.Bio</p></div><div class="detail-section"><h3>Let’s talk about your project</h3><div class="actions"><a class="btn" asp-page="/Messages" asp-route-pro="@p.Id">Start a conversation ↗</a>@if(!string.IsNullOrEmpty(p.Phone)){<a class="btn outline" href="tel:@p.Phone">Call @p.Phone</a>}</div></div><div class="detail-section"><form method="post" asp-page-handler="Save"><button class="btn small outline" type="submit">♡ Save professional</button></form><details><summary class="notice">Report this profile or block messages</summary><form method="post" asp-page-handler="Report"><label class="field"><span>What happened?</span><textarea name="reason" maxlength="2000" required></textarea></label><label class="toggle-label"><input type="checkbox" name="block" value="true"/> Also block this professional’s messages</label><div class="actions"><button class="btn small outline" type="submit">Send report</button></div></form></details></div><div class="detail-section"><h3>Customer reviews</h3>@if(p.Reviews.Count==0){<p>No reviews yet. You could be their first customer.</p>}@foreach(var review in p.Reviews){<div class="review"><span>@(new string('★',review.Rating))</span><p>@review.Text</p><small>From a completed appointment</small></div>}</div></section><aside class="panel"><span class="eyebrow muted">LET’S GET IT SORTED</span><h2>Book a helping hand</h2><p><strong>$@p.HourlyRate.ToString("0.00")</strong> / hour, starting from</p><p class="notice">Final price agreed directly. Pay the professional after service.</p><form method="post"><div asp-validation-summary="All"></div><label class="field"><span>Date & time (East Africa Time, UTC+3)</span><input asp-for="LocalStart" type="datetime-local" step="3600" required/></label><p class="field-hint">One-hour visits, @p.StartHour:00–@p.EndHour:00. Request at least 15 minutes ahead.</p><label class="field"><span>What do you need help with?</span><textarea asp-for="Description" maxlength="2000" placeholder="Tell us a little about the job…" required></textarea></label><label class="field"><span>Service address</span><input asp-for="Address" maxlength="300" placeholder="Street, building and neighborhood" required/></label><p class="notice">Your address is only shared with this professional.</p><button class="btn full" type="submit" disabled="@(!p.AcceptingRequests)">Request appointment ↗</button><p class="field-hint">Your time is reserved once the professional confirms.</p></form></aside></div></div>
