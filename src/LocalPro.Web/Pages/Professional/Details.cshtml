@page "{id:int}"
@inject ConfigurationService Configuration
@{var activeBrand=await Configuration.Get();}
@model LocalPro.Web.Pages.Professional.DetailsModel
@{ViewData["Title"]=Model.Pro.Name;var p=Model.Pro;}
<div class="page"><div class="breadcrumbs"><a asp-page="/Professionals">Find a professional</a> / @p.Category.Name / @p.Name</div>@if(TempData["Error"] is string error){<div class="error">@error</div>}@if(TempData["Success"] is string success){<div class="success">@success</div>}<div class="detail-grid"><section class="panel"><div class="profile-head"><div class="avatar avatar-@(p.Id%4)">@string.Concat(p.Name.Split(' ').Take(2).Select(n=>n[0]))</div><div><span class="pro-category">@p.Category.Icon @p.Category.Name</span><h1>@p.Name <span class="verified">✓</span></h1><p class="pro-location">⌖ @p.Neighborhood, @p.City</p></div></div><div class="detail-section"><span class="availability">@(p.AcceptingRequests?"● Accepting requests":"Currently unavailable")</span><p class="notice">Profile approved by @activeBrand.AppName. Qualifications have not been independently verified.</p><div class="tags"><span class="tag">@p.YearsExperience years of experience</span><span class="tag">@p.StartHour:00–@p.EndHour:00 · EAT</span><span class="tag">@p.Reviews.Count reviews</span></div></div><div class="detail-section"><h3>A little about me</h3><p>@p.Bio</p></div><div class="detail-section"><h3>Let’s talk about your project</h3><div class="actions"><a class="btn" asp-page="/Messages" asp-route-pro="@p.Id">Start a conversation ↗</a>@if(!string.IsNullOrEmpty(p.Phone)){<a class="btn outline" href="tel:@p.Phone">Call @p.Phone</a>}</div></div><div class="detail-section"><form method="post" asp-page-handler="Save"><button class="btn small outline" type="submit">♡ Save professional</button></form><details><summary class="notice">Report this profile or block messages</summary><form method="post" asp-page-handler="Report"><label class="field"><span>What happened?</span><textarea name="reason" maxlength="2000" required></textarea></label><label class="toggle-label"><input type="checkbox" name="block" value="true"/> Also block this professional’s messages</label><div class="actions"><button class="btn small outline" type="submit">Send report</button></div></form></details></div><div class="detail-section"><h3>Customer reviews</h3>@if(p.Reviews.Count==0){<p>No reviews yet. You could be their first customer.</p>}@foreach(var review in p.Reviews){<div class="review"><span>@(new string('★',review.Rating))</span><p>@review.Text</p><small>From a completed appointment</small></div>}</div></section><aside class="panel"><span class="eyebrow muted">DISPATCH MANAGED SERVICE</span><h2>Your request, coordinated.</h2><p>Our team reviews each request and assigns a suitable professional. Contact opens after assignment.</p><a class="btn" asp-page="/Requests/New" asp-route-category="@p.CategoryId">Submit a service request ↗</a><a class="text-link" asp-page="/Requests/Index">Track your requests</a></aside></div></div>
