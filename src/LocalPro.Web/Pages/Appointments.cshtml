@page
@model AppointmentsModel
@{ViewData["Title"]="Your appointments";}
<div class="page"><div class="page-heading"><span class="eyebrow muted">A LITTLE ORGANIZATION GOES A LONG WAY</span><h1>Your appointments.</h1><p>All your requests and upcoming visits, in one place. Times shown in East Africa Time (UTC+3).</p></div>@if(TempData["Success"] is string success){<div class="success">@success</div>}@if(TempData["Error"] is string error){<div class="error">@error</div>}@if(Model.Items.Count==0){<div class="empty"><span>▦</span><h3>Your calendar is clear</h3><p>Find a local professional and request your first appointment.</p><a class="btn" asp-page="/Index">Find a professional ↗</a></div>}
@foreach(var a in Model.Items){var owner=a.Professional.UserId==Model.UserId;<article class="panel appointment"><div><span class="status">@a.Status</span><h3>@a.Professional.Category.Icon @a.Professional.Name</h3><p>@Marketplace.ToLocal(a.StartUtc).ToString("dddd, dd MMM yyyy · HH:mm") EAT · 1 hour</p><p>Customer: @a.Customer.DisplayName</p><p>@a.Description</p><p>⌖ @a.Address</p><a class="text-link" asp-page="/Messages" asp-route-pro="@a.ProfessionalId" asp-route-customer="@(owner?a.CustomerId:null)">Open conversation ↗</a><div class="actions">@if(owner&&a.Status==AppointmentStatus.Requested){foreach(var action in new[]{"confirm","decline"}){<form method="post" asp-page-handler="Action"><input type="hidden" name="id" value="@a.Id"/><button class="btn outline" name="action" value="@action">@action</button></form>}}@if(a.Status==AppointmentStatus.Requested||a.Status==AppointmentStatus.Confirmed){<form method="post" asp-page-handler="Action"><input type="hidden" name="id" value="@a.Id"/><button class="btn outline" name="action" value="cancel">Cancel request</button></form>}@if(owner&&(a.Status==AppointmentStatus.Confirmed||a.Status==AppointmentStatus.InProgress)){<form method="post" asp-page-handler="Action"><input type="hidden" name="id" value="@a.Id"/><button class="btn" name="action" value="@(a.Status==AppointmentStatus.Confirmed?"start":"complete")">@(a.Status==AppointmentStatus.Confirmed?"Start work":"Mark completed")</button></form>}</div></div><div>@if(a.Status==AppointmentStatus.Confirmed){<form method="post" asp-page-handler="Action"><input type="hidden" name="id" value="@a.Id"/><input type="hidden" name="action" value="reschedule"/><label class="field"><span>Propose a new time (EAT)</span><input type="datetime-local" name="localStart" step="3600" required/></label><button class="btn small outline" type="submit">Propose new time</button></form>@if(a.ProposedStartUtc.HasValue){<p class="notice">Proposed: @Marketplace.ToLocal(a.ProposedStartUtc.Value).ToString("dd MMM HH:mm") EAT</p>@if(a.ProposedById!=Model.UserId){<form method="post" asp-page-handler="Action"><input type="hidden" name="id" value="@a.Id"/><button class="btn small" name="action" value="accept-time">Accept proposed time</button></form>}}}@if(!owner&&a.Status==AppointmentStatus.Completed){<form method="post" asp-page-handler="Review"><input type="hidden" name="id" value="@a.Id"/><label class="field"><span>Your rating</span><select name="rating"><option value="5">5 — Excellent</option><option value="4">4 — Good</option><option value="3">3 — Fair</option><option value="2">2 — Poor</option><option value="1">1 — Very poor</option></select></label><label class="field"><span>Your experience</span><textarea name="text" maxlength="1000"></textarea></label><button class="btn small" type="submit">Submit review</button></form>}</div></article>}</div>