@page
@model LocalPro.Web.Pages.Account.RegisterModel
@{ViewData["Title"]="Join your local community";}
<section class="auth panel"><span class="eyebrow muted">LET’S GET THINGS DONE</span><h1>A good place to start.</h1><p>Find local help, or bring your skills to the neighborhood.</p><form method="post"><div asp-validation-summary="All"></div><label class="field"><span>Full name</span><input asp-for="Name" autocomplete="name" maxlength="100" required/></label><label class="field"><span>Email address</span><input asp-for="Email" type="email" autocomplete="email" required/></label><label class="field"><span>Password</span><input asp-for="Password" type="password" autocomplete="new-password" minlength="10" required/><p class="field-hint">10+ characters, including uppercase, lowercase, number and symbol.</p></label><label class="toggle-label"><input asp-for="Terms" required/> I agree to the <a asp-page="/Privacy">privacy and service terms</a>.</label><button class="btn full" type="submit">Create account ↗</button></form><p>Already a member? <a asp-page="Login">Log in</a></p></section>