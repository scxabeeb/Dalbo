@page
@model LocalPro.Web.Pages.Account.RegisterModel
@inject ConfigurationService Configuration
@{var brand=await Configuration.Get();}
@{ViewData["Title"]="Isdiiwaangeli";}
<section class="auth panel"><span class="eyebrow muted">KU SOO BIIR @brand.AppName</span><h1>Akoon cusub samee.</h1><p>Dalbo adeeg ama ku soo biir xirfadlayaasha.</p><p class="notice">Akoon ma leedahay? <a class="text-link" asp-page="Login">Soo gal / Sign in with your email</a></p>@if(!Model.RegistrationEnabled){<p class="notice">New account registration is currently closed.</p>}else{<form method="post"><div asp-validation-summary="All"></div><label class="field"><span>Magaca oo buuxa</span><input asp-for="Name" autocomplete="name" maxlength="100" required/></label><label class="field"><span>Cinwaanka iimaylka</span><input asp-for="Email" type="email" autocomplete="email" required/></label><label class="field"><span>Furaha sirta</span><input asp-for="Password" type="password" autocomplete="new-password" minlength="10" required/><p class="field-hint">Ugu yaraan 10 xaraf: xarfo waaweyn, yaryar, lambar iyo calaamad.</p></label><label class="field"><span>Confirm password</span><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" minlength="10" required/></label><label class="toggle-label"><input asp-for="Terms" required/> Waan aqbalay <a asp-page="/Privacy">shuruudaha iyo asturnaanta</a>.</label><button class="btn full" type="submit">Samee akoon ↗</button></form>}<p>Akoon ma leedahay? <a asp-page="Login">Soo gal</a></p></section>
