@page
@model IndexModel
@inject ConfigurationService Configuration
@{ViewData["Title"]="Hoyga";var brand=await Configuration.Get();}
<div class="dx-home"><section class="dx-intro"><div><span class="dx-kicker">⌖ @brand.City</span><h1>@brand.HeroTitle</h1><p>@brand.Tagline</p><form method="get" asp-page="/Services" class="dx-search"><span>⌕</span><input name="q" aria-label="Raadi adeeg" placeholder="Raadi adeeg… (tusaale: Tuubiiste)"/><button class="btn" type="submit">Raadi ↗</button></form></div><aside class="dx-promo"><span class="dx-promo-icon">⚒</span><span class="dx-kicker">@Model.Categories.Count ADEEG · HAL APP</span><h2>@brand.HeroDescription</h2><p>Dooro adeegga. Samee dalab.<br/>La soco tallaabo kasta.</p><a class="btn dx-white" asp-page="/Services">Dalbo hadda ↗</a></aside></section><section class="dx-section"><div class="section-heading"><div><span class="dx-kicker">HALKAN KA BILOW</span><h2>Adeegyada ugu badan</h2></div><a class="text-link" asp-page="/Services">Dhammaan @Model.Categories.Count adeeg ↗</a></div><div class="dx-service-grid dx-home-popular">@foreach(var c in Model.Categories.Take(7)){<a class="dx-service" asp-page="/Requests/New" asp-route-category="@c.Id"><span class="dx-service-icon"><svg aria-hidden="true" width="25" height="25"><use href="/brand/services.svg#@ServiceCatalog.IconKey(c.Name)"/></svg></span><strong>@c.Name</strong><small>@c.Group</small><span class="dx-service-arrow">↗</span></a>}<a class="dx-service" asp-page="/Services"><span class="dx-service-icon"><svg aria-hidden="true" width="25" height="25"><use href="/brand/services.svg#grid"/></svg></span><strong>Dhammaan</strong><small>@Model.Categories.Count Adeeg</small><span class="dx-service-arrow">↗</span></a></div></section><section class="dx-section"><div class="section-heading"><div><span class="dx-kicker">LA SOCO TALLAABO KASTA</span><h2>Dalabkaaga socda</h2></div><a class="text-link" asp-page="/Requests/Index">Dalabyada oo dhan ↗</a></div>@if(Model.Requests.Count==0){<div class="dx-empty"><span class="dx-service-icon">▤</span><div><h3>Dalab cusub diyaar ma u tahay?</h3><p>Markaad dalbato, halkaad ayuu xaaladdiisu ka muuqanayaa.</p></div><a class="btn" asp-page="/Services">Dooro adeeg ↗</a></div>}@foreach(var order in Model.Requests){<a class="dx-order-preview" asp-page="/Requests/Track" asp-route-id="@order.Id"><span class="dx-service-icon"><svg aria-hidden="true" width="25" height="25"><use href="/brand/services.svg#@ServiceCatalog.IconKey(order.Category.Name)"/></svg></span><div><strong>@order.Category.Name</strong><p>@ServiceCatalog.Status(order.Status)</p></div><span class="status">#@order.Id ↗</span></a>}</section><section class="dx-how"><div><span>01</span><h3>Dooro adeegga</h3><p>@Model.Categories.Count adeeg oo kala duwan, hal app.</p></div><div><span>02</span><h3>Samee dalab</h3><p>Sharax baahidaada iyo goobtaada.</p></div><div><span>03</span><h3>La soco dalabka</h3><p>Ogow marka xirfadle laguu xilsaaro.</p></div></section><div class="dx-professional-banner"><div><h2>Ma tahay xirfadle?</h2><p>Isdiiwaangeli oo u adeeg dadka magaaladaada.</p></div><a class="btn" asp-page="/Professional/Edit">Ku biir @brand.AppName ↗</a></div></div>