@page
@model LocalPro.Web.Pages.ProductsModel
@{ViewData["Title"]="Products";}
<div class="page"><div class="dx-catalog-header"><span class="eyebrow">@Model.Settings.AppName</span><h1>Products for your everyday needs.</h1><p>Browse our latest products and contact us for availability.</p><form method="get" class="dx-search"><input asp-for="Q" placeholder="Search products" aria-label="Search products"/><button class="btn">Search</button></form></div><div class="product-grid">@foreach(var p in Model.Items){<article class="panel product-card">@if(p.ImageContentType!=null){<img src="/api/products/@p.Id/image?v=@p.UpdatedUtc.Ticks" alt="@p.Name" loading="lazy"/>}else{<div class="product-placeholder">▧</div>}<span class="eyebrow muted">@p.Category</span><h2>@p.Name</h2><p>@p.Description</p><strong>@Model.Settings.Currency @p.Price.ToString("0.00")</strong><small class="notice">@(p.Stock>0?$"{p.Stock} available":"Currently out of stock")</small></article>}</div>@if(Model.Items.Count==0){<div class="panel"><h2>No products yet.</h2><p class="notice">Check back soon for new products.</p></div>}</div>
