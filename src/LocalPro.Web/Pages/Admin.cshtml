@page
@model AdminModel
@{ViewData["Title"]="Administration";}
<div class="page"><div class="page-heading"><span class="eyebrow muted">DALBO OPERATIONS</span><h1>A healthier local marketplace.</h1></div><div class="stats"><div class="panel"><strong>@Model.Users</strong><span>Registered accounts</span></div><div class="panel"><strong>@Model.Profiles.Count</strong><span>Professional profiles</span></div><div class="panel"><strong>@Model.Bookings</strong><span>Appointment requests</span></div></div><h2>Professional approvals</h2><p class="notice">Approval publishes a profile. It does not imply qualification verification.</p>@foreach(var p in Model.Profiles){<div class="panel admin-row"><div><strong>@p.Name</strong><p class="notice">@p.Category.Name · @p.City · @(p.Approved?"Published":"Pending / suspended")</p><p>@p.Bio</p></div><form method="post" asp-page-handler="Approval"><input type="hidden" name="id" value="@p.Id"/><input type="hidden" name="approve" value="@((!p.Approved).ToString().ToLower())"/><button class="btn small @(p.Approved?"outline":"")" type="submit">@(p.Approved?"Suspend":"Approve profile")</button></form></div>}<section class="panel detail-section"><h3>Service categories</h3><div class="tags">@foreach(var c in Model.Categories){<span class="tag">@c.Name</span>}</div><form method="post" asp-page-handler="Category" class="actions"><label><span class="notice">New category</span><input name="name" maxlength="80" required/></label><button class="btn small" type="submit">Add category</button></form></section><section class="panel detail-section"><h3>Reports</h3>@foreach(var report in Model.Reports){<div class="detail-section"><strong>Professional #@report.ProfessionalId · @(report.Resolved?"Resolved":"Open")</strong><p>@report.Reason</p>@if(!report.Resolved){<form method="post" asp-page-handler="Resolve"><input type="hidden" name="id" value="@report.Id"/><button class="btn small" type="submit">Mark resolved</button></form>}</div>}</section><section class="panel detail-section"><h3>Recent audit events</h3>@foreach(var e in Model.Events){<p class="notice">@e.CreatedUtc.ToString("u") · @e.Action</p>}</section></div>
