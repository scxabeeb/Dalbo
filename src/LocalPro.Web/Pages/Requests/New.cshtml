@page
@model LocalPro.Web.Pages.Requests.NewModel
@{ViewData["Title"]="Samee Dalab";}
<div class="page dx-request-page"><a class="breadcrumbs" asp-page="/Services">← Adeegyada</a><div class="page-heading"><h1>Samee Dalab</h1><p>Faahfaahinta adeegga aad u baahan tahay.</p></div><form method="post" enctype="multipart/form-data"><input type="hidden" asp-for="Category"/><input type="hidden" asp-for="EditId"/><div asp-validation-summary="All"></div><div class="dx-selected-service"><span class="dx-service-icon"><svg aria-hidden="true" width="25" height="25"><use href="/brand/services.svg#@ServiceCatalog.IconKey(Model.Selected.Name)"/></svg></span><div><strong>@Model.Selected.Name</strong><p>@Model.Selected.Description</p></div></div><section class="panel"><label class="field"><span>Sharax ciladda</span><textarea asp-for="Description" maxlength="2000" required placeholder="Tusaale: Fiilooyinka qolka fadhiga ayaa danabku gooyay…"></textarea></label>@if(!Model.EditId.HasValue){<label class="field"><span>Ku dar sawir (ikhtiyaari)</span><input asp-for="Photo" type="file" accept="image/png,image/jpeg"/><small class="notice">PNG ama JPEG · ugu badnaan 3 MB · sawirka waa gaar.</small></label>}<h3>Goobta</h3><div class="form-row"><label class="field"><span>Magaalada</span><input asp-for="City" maxlength="80" required/></label><label class="field"><span>Xaafadda iyo cinwaanka</span><input asp-for="Address" maxlength="300" placeholder="Xaafad, waddo, dhisme…" required/></label></div><fieldset class="dx-options"><legend>Goorma?</legend>@foreach(var option in new[]{("Now","Hadda"),("Today","Maanta"),("Tomorrow","Berri")}){<label><input type="radio" asp-for="When" value="@option.Item1"/><span>@option.Item2</span></label>}</fieldset><fieldset class="dx-options"><legend>Habka lacag bixinta</legend><label><input type="radio" asp-for="Payment" value="MobileMoney"/><span>Mobile Money</span></label><label><input type="radio" asp-for="Payment" value="Cash"/><span>Lacag caddaan</span></label></fieldset><p class="notice">Habka aad dooratay waa doorbid keliya. Lacag app-ka lagama qaadayo; qiimaha kama dambaysta ah la heshiis xirfadlaha.</p><div class="dx-price"><span>Qiimaha booqashada</span><strong>@(Model.Selected.VisitFee.HasValue?$"${Model.Selected.VisitFee:0.00} USD":"Waa lagu soo wargelinayaa")</strong></div><button class="btn dx-gold full" type="submit">@(Model.EditId.HasValue?"Kaydi isbeddelka ↗":"Xaqiiji Dalabka ↗")</button><p class="notice">“Hadda” ma dammaanad qaado imaansho degdeg ah. Xirfadle ayaa marka hore laguu xilsaarayaa.</p></section></form></div>