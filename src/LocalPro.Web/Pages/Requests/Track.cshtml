@page "{id:int}"
@model LocalPro.Web.Pages.Requests.TrackModel
@{ViewData["Title"]="La soco Dalabka";var r=Model.Item;var uid=User.FindFirstValue(ClaimTypes.NameIdentifier);var owner=r.Professional?.UserId==uid;}
<div class="page dx-track-page" data-track-feed="@Url.Page("Track","Feed",new{id=r.Id})" data-status="@r.Status" data-updated="@r.UpdatedUtc.ToString("O")"><a class="breadcrumbs" asp-page="Index">← Dalabyada</a>@if(TempData["Error"] is string error){<div class="error">@error</div>}<div class="dx-tracking-banner"><span class="dx-service-icon"><svg aria-hidden="true" width="25" height="25"><use href="/brand/services.svg#@ServiceCatalog.IconKey(r.Category.Name)"/></svg></span><div><span class="dx-kicker">DALAB #@r.Id · @r.Category.Name</span><h1>@ServiceCatalog.Status(r.Status)</h1><p>Waqtiga imaanshaha weli lama xaqiijin. Xaaladdu si toos ah ayay u cusboonaanaysaa.</p></div></div><div class="detail-grid"><section class="panel">@if(r.Professional!=null){<div class="profile-head"><div class="avatar">@string.Concat(r.Professional.Name.Split(' ').Take(2).Select(n=>n[0]))</div><div><h2>@r.Professional.Name</h2><p>@r.Category.Name · Xirfadle laguu xilsaaray</p></div></div><div class="actions">@if(!string.IsNullOrWhiteSpace(r.Professional.Phone)){<a class="btn outline" href="tel:@r.Professional.Phone">Wac</a>}<a class="btn" asp-page="/Messages" asp-route-pro="@r.ProfessionalId" asp-route-customer="@(owner?r.CustomerId:null)">Fariin ↗</a></div>}else{<h2>Waxaan raadineynaa xirfadle</h2><p class="notice">Marka la kuu xilsaaro, magaciisa iyo xiriirkiisa halkan ayay ka muuqanayaan.</p>}<ol class="dx-timeline">@foreach(var e in r.Events.OrderBy(e=>e.CreatedUtc).ThenBy(e=>e.Id)){<li><span>✓</span><div><strong>@ServiceCatalog.Status(e.Status)</strong><small>@Marketplace.ToLocal(e.CreatedUtc).ToString("dd MMM · HH:mm") EAT</small></div></li>}</ol>@if(owner){<div class="actions">@if(r.Status==ServiceRequestStatus.Assigned){<form method="post"><button class="btn" name="action" value="depart">Waan soo socdaa</button></form>}@if(r.Status==ServiceRequestStatus.OnTheWay){<form method="post"><button class="btn" name="action" value="start">Bilow shaqada</button></form>}@if(r.Status==ServiceRequestStatus.InProgress){<form method="post"><button class="btn" name="action" value="complete">Shaqada waa dhammaatay</button></form>}</div>}</section><aside class="panel"><h3>Faahfaahinta dalabka</h3><p>@r.Description</p><div class="detail-section"><span class="notice">Goobta</span><p>@r.City · @r.Address</p><span class="notice">Goorma?</span><p>@ServiceCatalog.When(r.When)</p><span class="notice">Habka lacag bixinta</span><p>@(r.PaymentPreference=="Cash"?"Lacag caddaan":"Mobile Money")</p><p class="notice">Doorbid keliya · lacag lagama qaadin app-ka.</p></div>@if(r.PhotoFile!=null){<img class="dx-job-photo" src="@Url.Page("Track","Photo",new{id=r.Id})" alt="Sawirka ciladda"/>}<div class="actions">@if(uid==r.CustomerId&&(r.Status==ServiceRequestStatus.Received||r.Status==ServiceRequestStatus.Assigned||r.Status==ServiceRequestStatus.OnTheWay)){@if(r.Status!=ServiceRequestStatus.OnTheWay){<a class="btn outline" asp-page="/Requests/New" asp-route-editId="@r.Id">Beddel dalabka</a>}<form method="post"><button class="btn outline danger" name="action" value="cancel">Jooji dalabka</button></form>}</div></aside></div></div>