@page "{id:int}"
@model LocalPro.Web.Pages.Payments.InvoiceModel
@{ViewData["Title"]="Service invoice";var invoice=Model.Invoice;}
<div class="page invoice-page"><a class="breadcrumbs" asp-page="/Requests/Track" asp-route-id="@RouteData.Values["id"]">← Back to service request</a><section class="panel">@if(invoice==null){<h1>Your invoice will appear here.</h1><p>The service team will confirm the work and agreed total before issuing an invoice.</p>}else{<span class="invoice-id">INV-@invoice.Id.ToString("D6")</span><h1>@invoice.ServiceRequest.Category.Name</h1><p>@invoice.ServiceRequest.Customer.DisplayName · Request #@invoice.ServiceRequestId</p><span class="status">@invoice.Status</span><p>@invoice.Notes</p><div class="payment-summary"><span>Invoice total<strong>@invoice.Currency @invoice.Total.ToString("N2")</strong></span><span>Paid<strong>@invoice.Currency @invoice.Paid.ToString("N2")</strong></span><span>Balance due<strong>@invoice.Currency @invoice.Balance.ToString("N2")</strong></span></div><h2>Payment receipts</h2>@foreach(var p in invoice.Payments.OrderByDescending(p=>p.ReceivedUtc)){<div class="receipt-line"><div><strong>PAY-@p.Id.ToString("D6") · @PaymentService.MethodLabel(p.Method)</strong><small>@Marketplace.ToLocal(p.ReceivedUtc).ToString("dd MMM yyyy, HH:mm") EAT · @p.Reference</small></div><strong>@invoice.Currency @p.Amount.ToString("N2")</strong></div>}@if(invoice.Payments.Count==0){<p>No payments have been recorded.</p>}<p class="notice">Payments are confirmed by the service team after receipt. Contact CTC DALBO to arrange payment or ask about a transaction. No money is charged from this page.</p>}</section></div>
