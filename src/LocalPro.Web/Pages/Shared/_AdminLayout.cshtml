@inject ConfigurationService Configuration
@{var brand=await Configuration.Get();var current=(Context.Request.Path.Value??"").TrimEnd('/');var links=new[]{("/Manage/Index","Overview","dashboard"),("/Dispatch","Service requests","requests"),("/Manage/Payments","Payments & invoices","wallet"),("/Manage/Services","Services","tools"),("/Manage/Products","Products","box"),("/Manage/Users","People & access","users"),("/Admin","Approvals & reports","shield"),("/Manage/Settings","Brand & settings","settings")};}
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · @brand.AppName Admin</title><link rel="icon" href="/favicon.ico"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/danxaliye.css" asp-append-version="true"/><link rel="stylesheet" href="/brand/theme.css"/><link rel="stylesheet" href="~/css/admin.css" asp-append-version="true"/></head>
<body class="admin-body"><div class="admin-shell"><button class="admin-scrim" data-admin-close aria-label="Close navigation"></button><aside class="admin-sidebar" id="admin-sidebar" aria-label="Admin navigation"><a class="admin-brand" asp-page="/Manage/Index"><img src="@(brand.Logo==null?"/brand/ctc-dalbo-icon.png":"/api/settings/logo?v="+brand.UpdatedUtc.Ticks)" alt=""/><span>@brand.AppName<small>WORKSPACE</small></span></a><span class="admin-nav-caption">MANAGE YOUR BUSINESS</span><nav>@foreach(var link in links){var active=link.Item1=="/Manage/Index"?(current=="/Manage"||current=="/Manage/Index"):current==link.Item1;<a asp-page="@link.Item1" class="@(active?"is-active":"")" aria-current="@(active?"page":null)"><svg aria-hidden="true"><use href="/brand/admin.svg#@link.Item3"/></svg>@link.Item2@if(active){<span class="admin-active-dot"></span>}</a>}</nav><div class="admin-sidebar-bottom"><a class="admin-site-link" asp-page="/Index"><svg aria-hidden="true"><use href="/brand/admin.svg#external"/></svg>View customer website ↗</a><div class="admin-user"><span class="admin-avatar">A</span><div><strong>Administrator</strong><small>@User.Identity?.Name</small></div><form method="post" asp-page="/Account/Logout"><button title="Sign out" aria-label="Sign out">↗</button></form></div></div></aside><div class="admin-workspace"><header class="admin-topbar"><div class="admin-topbar-title"><button class="admin-menu-button" data-admin-toggle aria-controls="admin-sidebar" aria-expanded="false" aria-label="Open navigation">☰</button><span>Workspace <b>/</b> <strong>@ViewData["Title"]</strong></span></div><div class="admin-topbar-actions"><span class="admin-role"><i></i> Admin access</span><a asp-page="/Notifications" aria-label="Notifications"><svg><use href="/brand/admin.svg#bell"/></svg></a><span class="admin-avatar">A</span></div></header><main id="main-content" class="admin-content">@RenderBody()</main><footer class="admin-footer"><span>@brand.AppName · Administration</span><span>@brand.City · EAT (UTC+3)</span></footer></div></div><script src="~/js/site.js" asp-append-version="true"></script><script src="~/js/admin.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
