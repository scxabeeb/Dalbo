@inject ConfigurationService Configuration
@{var brand=await Configuration.Get();}
<!DOCTYPE html><html lang="so"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="@brand.Tagline"/><meta name="theme-color" content="@brand.PrimaryColor"/><title>@ViewData["Title"] · @brand.AppName</title><link rel="icon" href="~/favicon.ico" asp-append-version="true"/><link rel="apple-touch-icon" href="~/brand/danxaliye-touch.png"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/danxaliye.css" asp-append-version="true"/><link rel="stylesheet" href="/brand/theme.css"/></head><body><header class="header dx-header"><a class="brand" asp-page="/Index"><img src="@(brand.Logo==null?"/brand/danxaliye-logo.png":"/api/settings/logo?v="+brand.UpdatedUtc.Ticks)" alt="@brand.AppName" width="140" height="70"/></a><nav aria-label="Hagaha sare"><a asp-page="/Index">Hoyga</a><a asp-page="/Services">Adeegyada</a>@if(brand.ProductsEnabled){<a asp-page="/Products">Products</a>}<a asp-page="/Requests/Index">Dalabyada</a><a asp-page="/Messages">Fariimaha</a></nav><div class="header-actions">@if(User.Identity?.IsAuthenticated==true){<a asp-page="/Notifications" title="Ogeysiisyada">♧</a><a class="btn small light" asp-page="/Professional/Edit">Akoonka</a>@if(User.IsInRole("Admin")){<a asp-page="/Manage/Settings">Settings</a>}<form method="post" asp-page="/Account/Logout"><button class="avatar small-avatar" title="Ka bax">↗</button></form>}else{<a asp-page="/Account/Login">Soo gal</a>@if(brand.RegistrationEnabled){<a class="btn small" asp-page="/Account/Register">Isdiiwaangeli ↗</a>}}</div></header><main>@RenderBody()</main><footer><img src="@(brand.Logo==null?"/brand/danxaliye-logo.png":"/api/settings/logo?v="+brand.UpdatedUtc.Ticks)" alt="@brand.AppName" width="120" height="60"/><span>@brand.Tagline</span><a asp-page="/Professionals">Xirfadlayaasha</a><a asp-page="/Privacy">Asturnaanta & shuruudaha</a>@if(!string.IsNullOrEmpty(brand.ContactEmail)){<a href="mailto:@brand.ContactEmail">@brand.ContactEmail</a>}@if(!string.IsNullOrEmpty(brand.ContactPhone)){<span>@brand.ContactPhone</span>}<span>© @DateTime.UtcNow.Year @brand.AppName</span></footer><nav class="dx-bottom-nav" aria-label="Hagaha hoose"><a asp-page="/Index">⌂<span>Hoyga</span></a><a asp-page="/Services">▦<span>Adeegyada</span></a><a asp-page="/Requests/Index">▤<span>Dalabyada</span></a><a asp-page="/Professional/Edit">♙<span>Akoonka</span></a></nav><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>