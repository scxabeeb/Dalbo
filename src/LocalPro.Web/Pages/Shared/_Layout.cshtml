<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="Find local electricians, plumbers and cooling specialists. Connect, chat and book with Dalbo."/><title>@ViewData["Title"] · Dalbo</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body><header class="header"><a class="brand" asp-page="/Index"><span class="brand-icon">D<span>↗</span></span>Dalbo<span class="brand-dot">.</span></a><nav aria-label="Main navigation"><a asp-page="/Index">Find a professional</a><a asp-page="/Appointments">Appointments</a><a asp-page="/Messages">Messages</a></nav><div class="header-actions">@if(User.Identity?.IsAuthenticated==true){<a asp-page="/Notifications" title="Notifications">Updates</a><a asp-page="/Favorites" title="Saved professionals">♡</a><a class="btn small light" asp-page="/Professional/Edit">My business</a>@if(User.IsInRole("Admin")){<a asp-page="/Admin">Admin</a>}<form method="post" asp-page="/Account/Logout"><button class="avatar small-avatar" title="Sign out">@User.Identity.Name?[..1].ToUpper()</button></form>}else{<a asp-page="/Account/Login">Log in</a><a class="btn small" asp-page="/Account/Register">Join Dalbo ↗</a>}</div></header><main>@RenderBody()</main><footer><a class="brand" asp-page="/Index">Dalbo.</a><span>Good people. Great work. Right nearby.</span><a asp-page="/Privacy">Privacy & service terms</a><span>© @DateTime.UtcNow.Year Dalbo</span></footer><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required:false)</body></html>
