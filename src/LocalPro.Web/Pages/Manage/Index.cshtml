@page
@model LocalPro.Web.Pages.Manage.IndexModel
@{ViewData["Title"]="Overview";var cards=new[]{("Total requests",Model.Requests,"requests","/Dispatch"),("Awaiting assignment",Model.Waiting,"tools","/Dispatch"),("Approved professionals",Model.Professionals,"shield","/Admin"),("Registered accounts",Model.Customers,"users","/Manage/Users")};}
<div class="page"><div class="admin-heading"><div><span class="eyebrow muted">YOUR BUSINESS AT A GLANCE</span><h1>Welcome to your workspace.</h1><p>Manage services, support your customers, and keep every job moving.</p></div><a class="btn" asp-page="/Dispatch">Manage requests ↗</a></div><div class="admin-metrics">@foreach(var card in cards){<article class="admin-metric"><div class="metric-icon"><svg aria-hidden="true"><use href="/brand/admin.svg#@card.Item3"/></svg></div><a asp-page="@card.Item4" aria-label="View @card.Item1">↗</a><strong>@card.Item2.ToString("N0")</strong><span>@card.Item1</span></article>}</div><div class="admin-split"><section class="panel"><div class="admin-panel-title"><h2>Recent service requests</h2><a asp-page="/Dispatch">View all →</a></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Request</th><th>Customer</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var r in Model.Recent){<tr><td><strong>@r.Category.Name</strong><small>#@r.Id · @Marketplace.ToLocal(r.CreatedUtc).ToString("dd MMM, HH:mm")</small></td><td>@r.Customer.DisplayName<small>@r.City</small></td><td><span class="status">@r.Status</span></td><td><a asp-page="/Requests/Track" asp-route-id="@r.Id">View ↗</a></td></tr>}</tbody></table>@if(Model.Recent.Count==0){<div class="admin-empty">New requests will appear here when customers book a service.</div>}</div></section><aside><section class="panel admin-quick-links"><h2>Quick actions</h2><a asp-page="/Manage/Services"><span>Manage your services<small>Pricing, categories and availability</small></span>↗</a><a asp-page="/Manage/Payments"><span>Payments & invoices<small>Balances, payment records and receipts</small></span>↗</a><a asp-page="/Manage/Users"><span>People & permissions<small>Customer accounts and team access</small></span>↗</a><a asp-page="/Manage/Settings"><span>Make it yours<small>Brand, logo and business settings</small></span>↗</a></section><section class="panel admin-collections"><h2>Recorded collections</h2>@if(Model.Collections.Count==0){<p class="admin-empty">No payments recorded yet.</p>}@foreach(var collection in Model.Collections){<div class="payment-summary"><span>@collection.Currency</span><strong>@collection.Total.ToString("N2")</strong></div>}<p class="notice">Confirmed payment records, grouped by currency.</p></section></aside></div></div>
