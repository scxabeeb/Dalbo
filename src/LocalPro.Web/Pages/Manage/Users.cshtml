@page
@model LocalPro.Web.Pages.Manage.UsersModel
@{ViewData["Title"]="Manage users";}
<div class="page manage-page"><partial name="_Nav"/><div class="page-heading"><span class="eyebrow muted">PEOPLE & ACCESS</span><h1>Your community.</h1><p>Create accounts and manage administrator access.</p></div>@if(Model.Notice!=null){<p class="notice" role="status">@Model.Notice</p>}<div class="manage-grid"><section class="panel"><h2>Create user</h2><form method="post"><div asp-validation-summary="All"></div><label class="field">Full name<input asp-for="Input.Name" maxlength="100" autocomplete="off" required/></label><label class="field">Email<input asp-for="Input.Email" type="email" required/></label><label class="field">Password<input asp-for="Input.Password" type="password" autocomplete="new-password" minlength="10" required/><small>10+ characters, uppercase, lowercase, number and symbol.</small></label><button class="btn">Create user</button></form></section><section class="panel"><h2>Registered users</h2><form method="get" class="actions"><input asp-for="Q" aria-label="Search by email or name" placeholder="Search name or email"/><button class="btn small">Search</button></form><p class="notice">Showing up to 100 matches.</p>@foreach(var u in Model.Items){var admin=Model.AdminIds.Contains(u.Id);<div class="manage-item"><div><strong>@u.DisplayName</strong><p class="notice">@u.Email · @(admin?"Administrator":"Member")</p></div><form method="post" asp-page-handler="Role"><input name="id" type="hidden" value="@u.Id"/><input name="admin" type="hidden" value="@((!admin).ToString().ToLowerInvariant())"/><button class="btn small outline" disabled="@(u.Id==User.FindFirstValue(ClaimTypes.NameIdentifier))">@(admin?"Remove admin":"Make admin")</button></form></div>}</section></div></div>
