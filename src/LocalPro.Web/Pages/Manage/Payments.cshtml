@page
@model LocalPro.Web.Pages.Manage.PaymentsModel
@{ViewData["Title"]="Payments & invoices";}
<div class="page"><div class="admin-heading"><div><span class="eyebrow muted">SERVICE FINANCES</span><h1>Every payment, accounted for.</h1><p>Create service invoices, record received payments, and track outstanding balances.</p></div><span class="invoice-status">@Model.Currency</span></div>@if(Model.Notice!=null){<p class="success" role="status">@Model.Notice</p>}@if(Model.Error!=null){<p class="error" role="alert">@Model.Error</p>}<div class="admin-metrics"><article class="admin-metric"><span>Recorded collections · @Model.Currency</span><strong>@Model.Collected.ToString("N2")</strong></article><article class="admin-metric"><span>Outstanding · @Model.Currency</span><strong>@Model.Outstanding.ToString("N2")</strong></article><article class="admin-metric"><span>Recent invoices shown</span><strong>@Model.Invoices.Count</strong></article><article class="admin-metric"><span>Requests ready to invoice</span><strong>@Model.Requests.Count</strong></article></div><div class="admin-split"><section class="panel"><div class="admin-panel-title"><h2>Invoice register</h2><span class="notice">Latest 200</span></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Invoice / service</th><th>Total</th><th>Balance</th><th>Status</th></tr></thead><tbody>@foreach(var i in Model.Invoices){<tr><td><a asp-route-invoice="@i.Id">INV-@i.Id.ToString("D6")</a><small>@i.ServiceRequest.Category.Name · @i.ServiceRequest.Customer.DisplayName</small></td><td>@i.Currency @i.Total.ToString("N2")</td><td>@i.Balance.ToString("N2")</td><td><span class="invoice-status @i.Status.ToLowerInvariant().Replace(" ","-")">@i.Status</span></td></tr>}</tbody></table>@if(Model.Invoices.Count==0){<div class="admin-empty">Your first invoice starts with a service request.</div>}</div><p class="admin-note">Record funds only after confirming receipt with your bank or payment provider. No funds are transferred from this workspace.</p></section><aside class="panel"><h2>Create an invoice</h2><form method="post" asp-page-handler="Create"><label class="field">Service request<select name="requestId" required><option value="">Select a request</option>@foreach(var r in Model.Requests){<option value="@r.Id">#@r.Id · @r.Category.Name · @r.Customer.DisplayName</option>}</select></label><label class="field">Agreed total (@Model.Currency)<input name="total" type="number" step="0.01" min="0.01" max="10000000" required/></label><label class="field">Invoice notes<textarea name="notes" rows="3" maxlength="1000" placeholder="Describe the agreed work and charges"></textarea></label><button class="btn full">Create invoice</button><p class="notice">Invoice totals are fixed after creation. An unpaid invoice may be voided. Existing invoices retain their original currency.</p></form></aside></div>@if(Model.Selected is {} invoice){<section class="panel admin-collections"><div class="admin-panel-title"><div><span class="invoice-id">INV-@invoice.Id.ToString("D6") · REQUEST #@invoice.ServiceRequestId</span><h2>@invoice.ServiceRequest.Category.Name</h2></div><span class="invoice-status @invoice.Status.ToLowerInvariant().Replace(" ","-")">@invoice.Status</span></div><p>@invoice.ServiceRequest.Customer.DisplayName · @invoice.ServiceRequest.City</p><p class="notice">@invoice.Notes</p><div class="payment-summary"><span>Total<strong>@invoice.Currency @invoice.Total.ToString("N2")</strong></span><span>Received<strong>@invoice.Paid.ToString("N2")</strong></span><span>Outstanding<strong>@invoice.Balance.ToString("N2")</strong></span></div><div class="actions"><a class="btn outline" asp-page="/Payments/Invoice" asp-route-id="@invoice.ServiceRequestId">View customer receipt ↗</a>@if(!invoice.Voided&&invoice.Payments.Count==0){<form method="post" asp-page-handler="Void"><input type="hidden" name="invoiceId" value="@invoice.Id"/><button class="btn outline danger">Void unpaid invoice</button></form>}</div>@if(!invoice.Voided&&invoice.Balance>0){<h3>Record a received payment</h3><form method="post" asp-page-handler="Record"><input type="hidden" name="invoiceId" value="@invoice.Id"/><input type="hidden" name="key" value="@Guid.NewGuid()"/><div class="form-row"><label class="field">Amount (@invoice.Currency)<input name="amount" type="number" min="0.01" max="@invoice.Balance.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.01" required/></label><label class="field">Payment method<select name="method">@foreach(var method in PaymentService.Methods){<option value="@method">@PaymentService.MethodLabel(method)</option>}</select></label></div><label class="field">Transaction reference (required except cash)<input name="reference" maxlength="100" placeholder="Reference from the payment provider"/></label><button class="btn">Confirm received payment</button></form>}<h3>Payment history</h3>@foreach(var payment in invoice.Payments.OrderByDescending(p=>p.ReceivedUtc)){<div class="receipt-line"><div><strong>Receipt PAY-@payment.Id.ToString("D6") · @PaymentService.MethodLabel(payment.Method)</strong><small>@Marketplace.ToLocal(payment.ReceivedUtc).ToString("dd MMM yyyy, HH:mm") EAT · @payment.Reference</small></div><strong>@invoice.Currency @payment.Amount.ToString("N2")</strong></div>}@if(invoice.Payments.Count==0){<p class="notice">No payments recorded.</p>}</section>}</div>
