@page
@model LocalPro.Web.Pages.Manage.ProductsModel
@{ViewData["Title"]="Manage products";}
<div class="page manage-page"><div class="page-heading"><span class="eyebrow muted">YOUR CATALOG</span><h1>Products.</h1><p>Create products, update pricing and stock, or archive items.</p></div>@if(Model.Notice!=null){<p class="success" role="status">@Model.Notice</p>}<div class="manage-grid"><section class="panel"><h2>@(Model.Input.Id==0?"Add product":"Edit product")</h2><form method="post" enctype="multipart/form-data"><div asp-validation-summary="All" role="alert"></div><input asp-for="Input.Id" type="hidden"/><label class="field">Product name<input asp-for="Input.Name" maxlength="120" required/></label><label class="field">Category<input asp-for="Input.Category" maxlength="80"/></label><label class="field">Description<textarea asp-for="Input.Description" maxlength="2000" rows="4"></textarea></label><div class="manage-grid"><label class="field">Price<input asp-for="Input.Price" type="number" min="0" max="10000000" step="0.01"/></label><label class="field">Stock<input asp-for="Input.Stock" type="number" min="0" max="1000000"/></label></div><label class="field">Sort order<input asp-for="Input.SortOrder" type="number"/></label><label class="field">Product photo<input asp-for="ImageFile" type="file" accept="image/png,image/jpeg"/><small>PNG or JPEG, up to 2 MB.</small></label><label class="toggle-label"><input asp-for="RemoveImage"/> Remove existing photo</label><label class="toggle-label"><input asp-for="Input.Active"/> Published</label><div class="actions"><button class="btn" type="submit">Save product</button><a asp-page="Products">Clear form</a></div></form></section><section class="panel"><h2>All products <span class="muted">(@Model.Items.Count)</span></h2>@if(Model.Items.Count==0){<p class="notice">Your catalog is empty. Add your first product.</p>}@foreach(var item in Model.Items){<div class="manage-item"><div><strong>@item.Name</strong><p class="notice">@item.Category · @item.Price.ToString("0.00") · @item.Stock in stock · @(item.Active?"Published":"Archived")</p></div><div class="actions"><a class="text-link" asp-route-edit="@item.Id">Edit</a><form method="post" asp-page-handler="Toggle"><input name="id" type="hidden" value="@item.Id"/><button class="btn outline small">@(item.Active?"Archive":"Publish")</button></form></div></div>}</section></div></div>
