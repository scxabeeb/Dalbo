@page
@model LocalPro.Web.Pages.Manage.SettingsModel
@{ViewData["Title"]="Brand & settings";}
<div class="page manage-page"><partial name="_Nav"/><div class="page-heading"><span class="eyebrow muted">YOUR WORKSPACE</span><h1>Make it your own.</h1><p>One place to manage your identity, contact details and app preferences.</p></div>
@if(Model.Notice!=null){<p class="success" role="status">@Model.Notice</p>}
<form method="post" enctype="multipart/form-data"><div asp-validation-summary="All" role="alert"></div><div class="manage-grid"><section class="panel"><h2>Brand identity</h2><p class="notice">Changes appear on the website and in the mobile app.</p><label class="field">Application name<input asp-for="Input.AppName" maxlength="80" required/></label><label class="field">Tagline<input asp-for="Input.Tagline" maxlength="160"/></label><div class="manage-grid"><label class="field">Primary color<input asp-for="Input.PrimaryColor" type="color"/></label><label class="field">Accent color<input asp-for="Input.AccentColor" type="color"/></label></div><img class="settings-logo" src="@Model.LogoUrl" alt="Current logo"/><label class="field">Upload logo<input asp-for="LogoFile" type="file" accept="image/png,image/jpeg"/><small>PNG or JPEG, maximum 2 MB. Use a wide logo with a clear background.</small></label><label><input asp-for="ResetLogo"/> Restore original logo</label></section><section class="panel"><h2>Business & preferences</h2><label class="field">Default city<input asp-for="Input.City" maxlength="80" required/></label><label class="field">Currency code<input asp-for="Input.Currency" maxlength="3" pattern="[A-Z]{3}" required/><small>Three uppercase letters, for example USD or SOS.</small></label><label class="field">Contact email<input asp-for="Input.ContactEmail" type="email" maxlength="200"/></label><label class="field">Contact phone<input asp-for="Input.ContactPhone" maxlength="30"/></label><label class="toggle-label"><input asp-for="Input.RegistrationEnabled"/> Allow new account registration</label><label class="toggle-label"><input asp-for="Input.ProductsEnabled"/> Show product catalog</label><label class="field">Home page headline<input asp-for="Input.HeroTitle" maxlength="160"/></label><label class="field">Home page description<textarea asp-for="Input.HeroDescription" maxlength="300" rows="3"></textarea></label></section></div><div class="actions"><button class="btn" type="submit">Save settings ↗</button><a class="btn outline" asp-page="/Index">View website</a></div></form></div>
