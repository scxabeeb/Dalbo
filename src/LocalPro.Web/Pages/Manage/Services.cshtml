@page
@model LocalPro.Web.Pages.Manage.ServicesModel
@{ViewData["Title"]="Manage services";}
<div class="page manage-page"><partial name="_Nav"/><div class="page-heading"><span class="eyebrow muted">YOUR SERVICES</span><h1>A service for every need.</h1><p>Manage names, groups, descriptions, visit fees and visibility.</p></div>@if(Model.Notice!=null){<p class="success">@Model.Notice</p>}<div class="manage-grid"><section class="panel"><h2>@(Model.Input.Id==0?"Add service":"Edit service")</h2><form method="post"><div asp-validation-summary="All"></div><input asp-for="Input.Id" type="hidden"/><label class="field">Name<input asp-for="Input.Name" maxlength="80" required/></label><label class="field">Icon character<input asp-for="Input.Icon" maxlength="20" required/></label><label class="field">Group<input asp-for="Input.Group" maxlength="30" required/></label><label class="field">Description<textarea asp-for="Input.Description" maxlength="300" rows="3"></textarea></label><label class="field">Visit fee (leave empty for quotation)<input asp-for="Input.VisitFee" type="number" min="0" max="10000000" step="0.01"/></label><label class="field">Sort order<input asp-for="Input.SortOrder" type="number"/></label><label class="toggle-label"><input asp-for="Input.Active"/> Available in catalog</label><div class="actions"><button class="btn">Save service</button><a asp-page="Services">Clear form</a></div></form></section><section class="panel"><h2>Service catalog</h2>@foreach(var c in Model.Items){<div class="manage-item"><div><strong>@c.Icon @c.Name</strong><p class="notice">@c.Group · @(c.Active?"Active":"Hidden") · @(c.VisitFee?.ToString("0.00")??"Quote")</p></div><a class="text-link" asp-route-edit="@c.Id">Edit</a></div>}</section></div></div>
