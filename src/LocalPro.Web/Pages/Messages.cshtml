@page
@model MessagesModel
@{ViewData["Title"]="Your conversations";}
<div class="page"><div class="page-heading"><span class="eyebrow muted">GREAT WORK STARTS WITH A CONVERSATION</span><h1>Let’s talk.</h1><p>Discuss the details before making it official.</p></div>@if(TempData["Error"] is string e){<div class="error">@e</div>}@if(Model.Error!=null){<div class="error">@Model.Error</div>}<div class="chat-layout"><aside class="panel chat-sidebar"><strong>Conversations</strong>@foreach(var t in Model.Threads){<a asp-route-pro="@t.Pro" asp-route-customer="@t.Customer">@t.Name <span>↗</span></a>}@if(Model.Threads.Count==0){<p class="notice">No conversations yet. Open a professional profile to start one.</p>}</aside><section class="panel">@if(Model.Pro.HasValue){<h3>@Model.Name</h3><p class="notice">Private conversation · New messages refresh automatically.</p><div class="chat-window" data-user="@Model.UserId" data-feed="@Url.Page("/Messages","Feed",new{pro=Model.Pro,customer=Model.Customer})" aria-live="polite">@if(Model.Items.Count==0){<p class="notice">Say hello and tell them what you have in mind.</p>}@foreach(var msg in Model.Items){<div class="bubble @(msg.SenderId==Model.UserId?"mine":"")">@msg.Text<small>@Marketplace.ToLocal(msg.CreatedUtc).ToString("dd MMM · HH:mm") EAT</small></div>}</div><form method="post" class="chat-compose"><input type="hidden" asp-for="Pro"/><input type="hidden" asp-for="Customer"/><label class="full"><span class="notice">Your message</span><textarea asp-for="Text" maxlength="2000" required placeholder="Write a message…"></textarea></label><button class="btn" type="submit">Send ↗</button></form>}else{<div class="empty"><span>☏</span><h3>A little conversation goes a long way.</h3><p>Choose a conversation or find a professional to get started.</p><a class="btn" asp-page="/Index">Explore professionals</a></div>}</section></div></div>